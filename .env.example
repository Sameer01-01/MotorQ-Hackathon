# Application & Runtime
ENVIRONMENT=production
LOG_LEVEL=INFO
APP_PORT=8000
WEB_PORT=5173

# Relational Metadata (PostgreSQL 16)
DATABASE_URL=sqlite:///./fleet_lite.db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fleetsentinel_oltp
POSTGRES_USER=fleet_admin
POSTGRES_PASSWORD=FleetPassword#2026

# Streaming Broker (Apache Kafka KRaft)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=telemetry.raw.v1
KAFKA_TOPIC_CANONICAL=telemetry.canonical.v1
KAFKA_TOPIC_ALERTS=alerts.v1
KAFKA_TOPIC_DLQ=telemetry.dlq.v1
KAFKA_CONSUMER_GROUP=fleetsentinel-stream-workers

# Columnar Time-Series Analytics (ClickHouse / DuckDB)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=fleetsentinel_analytics
CLICKHOUSE_USER=click_admin
CLICKHOUSE_PASSWORD=ClickPassword#2026
DUCKDB_PATH=fleet_telemetry.duckdb

# Hot State & Cache (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=RedisAuth#2026
REDIS_TTL_VEHICLE_STATE_SECONDS=86400

# Object Storage & S3 Archive (MinIO)
MINIO_ENDPOINT=http://localhost:9005
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=MinioPassword#2026
MINIO_BUCKET_COLD_ARCHIVE=fleetsentinel-telemetry-parquet

# Security, OIDC & Token Keys
JWT_SECRET_KEY=9a3f2b8c1d4e7f0a9b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OIDC_ISSUER=http://localhost:8080/realms/fleetsentinel

# Telematics Standards & Thresholds (AIS-140)
COOLANT_MAX_CELSIUS=105.0
VOLTAGE_MIN_VOLTS=12.4
STREAM_TARGET_EVENTS_PER_SEC=5000
